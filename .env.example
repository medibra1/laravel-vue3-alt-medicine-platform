APP_NAME="Ruqya Practice Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOCALE=fr
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ruqya
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=sync

# Required for Patient documents (PDF thumbnails via spatie/laravel-medialibrary) —
# the default 'gd' driver can't read PDFs, so identity/medical/other thumbnails
# would silently fail to generate without this. Requires the PHP imagick
# extension (ext-imagick) plus ImageMagick + Ghostscript on the host.
IMAGE_DRIVER=imagick

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
